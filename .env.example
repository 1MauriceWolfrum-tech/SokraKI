# Kopiere diese Datei nach .env.local und trage die Werte ein.

# "skript" = sokratischer Dialog nach festem Drehbuch (ohne KI, ohne Kosten)
# "claude" = KI-Coach über die Claude API (benötigt Zugangsdaten, siehe README)
COACH_MODUS=skript

# Zugang zur Claude API. Alternativ reicht ein mit `ant auth login` angelegtes Profil.
ANTHROPIC_API_KEY=

# Optional: Modell und Denktiefe des Coachs
COACH_MODELL=claude-opus-5-5
COACH_EFFORT=low
